# Build output: Xcode and SwiftPM make all of this again.
.build/
build/
.swiftpm/
xcuserdata/
*.xcuserstate
.DS_Store

# Your own team ID and bundle identifier (see README), and signing material
# tied to one Apple Developer account.
Config/Local.xcconfig
*.provisionprofile
*.p12
*.mobileprovision

# Playwright, if installed next to the bridge tests.
node_modules/

# Apple's product bezels (Apple Design Resources): Apple's licence forbids passing them on. bezels.sh fetches them.
Marketing/AppStore/source/bezels/

# App Store Connect API keys never belong here; the one in use lives in ~/.appstoreconnect/private_keys.
*.p8
