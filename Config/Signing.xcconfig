// Signing. Your own team ID goes in Config/Local.xcconfig, which git
// ignores, so a regenerated project and a pull request both leave it alone:
//
//     DEVELOPMENT_TEAM = ABCDE12345
//     PRODUCT_BUNDLE_IDENTIFIER = com.example.safience   (if this one is taken)
//
// Xcode > Settings > Accounts shows the team ID.
//
// Safience is signed with Apple's browser entitlement (Config/Safience.entitlements),
// which Apple granted to the team that publishes it. A team without it can't
// sign with it: such a team turns it off in Local.xcconfig, and the app then
// builds and runs as before, without passkeys and without being offered as
// the default browser:
//
//     CODE_SIGN_ENTITLEMENTS =
PRODUCT_BUNDLE_IDENTIFIER = net.taehee.safience
DEVELOPMENT_TEAM =
CODE_SIGN_ENTITLEMENTS = Config/Safience.entitlements

#include? "Local.xcconfig"
