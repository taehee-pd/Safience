<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Apple's browser entitlement. With it, iPadOS offers Safience as a default
  browser and WebKit lets pages use passkeys for any site. Apple grants it to
  a team on request (README › With Apple's browser entitlement); signing with
  it before then fails, so it is used only when Config/Local.xcconfig says
  CODE_SIGN_ENTITLEMENTS = Config/Browser.entitlements.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.web-browser</key>
	<true/>
</dict>
</plist>
