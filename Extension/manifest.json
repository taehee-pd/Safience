{
  "manifest_version": 3,
  "name": "Safience Sync",
  "description": "Your Chrome profile's bookmarks, pinned tabs and open tabs, with a space in Safience on your iPhone and iPad, through your iCloud.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Safience Sync",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "bookmarks",
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "identity"
  ],
  "host_permissions": [
    "https://api.apple-cloudkit.com/*"
  ]
}
