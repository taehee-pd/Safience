        }
      }
    },
    "A workspace backup contains spaces, tab addresses and bookmarks. Sign-ins and unsaved website content are not included.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A workspace backup contains spaces, tab addresses and bookmarks. Sign-ins and unsaved website content are not included."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 공간 백업에는 공간, 탭 주소 및 책갈피가 포함됩니다. 로그인 정보와 저장되지 않은 웹사이트 콘텐츠는 포함되지 않습니다."
          }
        }
      }
    },
